# ==============================================================================
# Environment Configuration — Cabinet de Me Arnaud Cheynut (Monaco)
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local, .env, or live API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Database, Auth, Private Storage)
# Required for contact submissions, newsletter signups, and private file uploads
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 2. Site & Domain Configuration
# Used for canonical URLs, OpenGraph metadata, and sitemap generation
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://anaudcheynut.com

# ------------------------------------------------------------------------------
# 3. Transactional Email — Resend / SMTP (ADR-003)
# Used to dispatch instant client notifications and cabinet intake alerts
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_placeholder
CONTACT_EMAIL_TO=contact@anaudcheynut.com
CONTACT_EMAIL_FROM=cabinet@anaudcheynut.com

# ------------------------------------------------------------------------------
# 4. AI Legal Secretary Assistant — Gemini / OpenRouter (ADR-004)
# Powers the preliminary intake assistant (FR/EN) with strict ethical guardrails
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-placeholder
OPENROUTER_API_KEY=your-openrouter-api-key-placeholder
